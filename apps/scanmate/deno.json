{
  "tasks": {
    "dev": "deno run -P=app --watch main.ts",
    "check": "deno check main.ts",
    "build:css": "deno run -A npm:@tailwindcss/cli -i ./src/input.css -o ./static/styles.css",
    "watch:css": "deno run -A npm:@tailwindcss/cli -i ./src/input.css -o ./static/styles.css --watch"
  },
  "imports": {
    "@sleipnir/core": "./../../packages/sleipnir/mod.ts",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.8",
    "@tailwindcss/cli": "npm:@tailwindcss/cli@^4.3.3",
    "daisyui": "npm:daisyui@^5.7.46",
    "hono": "npm:hono@^4.13.10",
    "pdf-lib": "npm:pdf-lib@^1.17.1",
    "prettier": "npm:prettier@^3.5.2",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "zod": "npm:zod@^3.24.2"
  },
  "permissions": {
    "app": {
      "all": true
    }
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  }
}
