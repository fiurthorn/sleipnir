{
  "workspace": [
    "./packages/*",
    "./apps/*"
  ],
  "permissions": {
    "app": {
      "all": true
    }
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "dev:notemate": "deno run -P=app --watch apps/notemate/main.ts",
    "dev:chatmate": "deno run -P=app --watch apps/chatmate/main.ts",
    "dev:scanmate": "deno run -P=app --watch apps/scanmate/main.ts",
    "dev:agentmate": "deno run -P=app --unstable-cron --watch apps/agentmate/main.ts",
    "check": "deno check packages/**/*.ts apps/**/*.ts apps/**/*.tsx",
    "lint": "deno lint",
    "test": "deno test -P=app"
  },
  "exclude": [
    "shelf/",
    "dist/",
    "node_modules/",
    "**/static/",
    "test.ts"
  ],
  "lint": {
    "include": ["packages/", "apps/"],
    "exclude": ["**/static/", "**/dist/"],
    "rules": {
      "tags": [
        "recommended",
        "jsx",
        "workspace",
        "jsr"
      ],
      "include": [
        "ban-types",
        "ban-ts-comment",
        "no-unused-vars",
        "no-explicit-any",
        "no-non-null-assertion",
        "prefer-const",
        "default-param-last",
        "no-self-compare",
        "no-throw-literal",
        "no-debugger",
        "verbatim-module-syntax",
        "no-sloppy-imports"
      ],
      "exclude": [
        "no-control-regex"
      ]
    }
  },
  "fmt": {
    "include": ["packages/", "apps/", "doc/", "README.md", "deno.json"],
    "exclude": ["**/static/", "**/dist/"],
    "sortNamedImports": "caseInsensitive",
    "sortNamedExports": "caseInsensitive",
    "trailingCommas": "onlyMultiLine",
    "useTabs": false,
    "lineWidth": 150,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "bracePosition": "sameLine",
    "newLineKind": "lf",
    "useBraces": "whenNotSingleLine",
    "quoteProps": "consistent"
  },
  "test": {
    "exclude": ["test.ts"]
  }
}
